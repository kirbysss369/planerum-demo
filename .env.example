# Copy to .env on the target host; keep .env private and out of Git.
# These are placeholders. A successful Compose config check does not validate credentials.
POSTGRES_PASSWORD=replace-with-a-long-random-password
SERVICE_TOKEN=replace-with-a-long-random-token
# Host binding for the app. Keep loopback defaults unless a public demo is intended.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
CLOUD_API_KEY=replace-with-the-assigned-key
# Direct Cloud.ru is the default. The only other accepted base URL is
# https://hub.gigaschool.ru/api/v1/llm/v1 (GigaSchool LLM gateway).
CLOUD_BASE_URL=https://foundation-models.api.cloud.ru/v1
# The selected ID must also appear in CLOUD_ALLOWED_MODEL_IDS.
CLOUD_MODEL_ID=replace-with-a-verified-internal-DeepSeek-or-Qwen-ID
CLOUD_ALLOWED_MODEL_IDS=replace-with-comma-separated-verified-internal-IDs
# Optional requested per-request response limit, 1..8192. Empty uses 8192 for direct
# Cloud.ru and 4096 for the gateway. This is not a spending limit.
CLOUD_MAX_RESPONSE_TOKENS=
